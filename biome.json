{
  "formatter": { "enabled": false },
  "json": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "assist": { "enabled": false },
  "linter": {
    "rules": {
      "preset": "none",
      "correctness": { "preset": "recommended" },
      "suspicious": {
        "noDebugger": "error",
        "noDuplicateCase": "error",
        "noDuplicateObjectKeys": "error",
        "noFocusedTests": "error"
      }
    }
  }
}
