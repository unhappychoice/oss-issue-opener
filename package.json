{
  "name": "oss-issue-opener",
  "version": "1.0.0",
  "description": "Weekly automated issue opener for OSS maintenance tasks",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "lint": "biome lint --error-on-warnings",
    "test": "npm run build && node --test",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include='dist/**/*.js' --test-coverage-lines=97 --test-coverage-branches=95 --test-coverage-functions=99",
    "start": "node dist/index.js",
    "check": "npm run build && npm run start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "smol-toml": "^1.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
